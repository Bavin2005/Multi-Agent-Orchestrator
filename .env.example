# Copy to .env and fill in. Never commit .env.
# Provider: openrouter | nvidia | mock  (mock = offline deterministic client)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
# Optional overrides (model ids are provider-specific; confirm them in your provider console)
LLM_RECON_MODEL=
LLM_CLASSIFIER_MODEL=
